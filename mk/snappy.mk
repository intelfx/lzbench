# snappy: config.h and snappy-stubs-public.h are generated by snappy's own CMake
# configuration, which probes the compiler for the features snappy uses (SSSE3,
# BMI2, NEON, RVV, byte order, ...). Only the configure step is run, in
# lz/snappy/build/; the objects are built by the rules in the Makefile.
CODECS += SNAPPY

HAVE_CMAKE := $(shell command -v cmake >/dev/null 2>&1 && echo 1 || echo 0)
ifneq ($(HAVE_CMAKE),1)
    $(info CMake not found – skipping snappy build)
    DONT_BUILD_SNAPPY ?= 1
endif

SNAPPY_BUILD := lz/snappy/build
SNAPPY_OBJS  := $(addprefix lz/snappy/, snappy-sinksource.o snappy-stubs-internal.o snappy.o)
SNAPPY_FLAGS := -DHAVE_CONFIG_H -I$(SNAPPY_BUILD)
CLEAN_DIRS   += $(SNAPPY_BUILD)

ifneq ($(DONT_BUILD_SNAPPY),1)
    # snappy.h includes snappy-stubs-public.h
    bench/lz_codecs.o: CODEC_FLAGS += -I$(SNAPPY_BUILD)
    $(SNAPPY_OBJS) bench/lz_codecs.o: $(SNAPPY_BUILD)/config.h

    # The probes are compiled with the flags lzbench is built with (-march,
    # -m32, ...), less the include paths, defines and dependency flags.
    SNAPPY_CMAKE_ARGS := \
        -DCMAKE_C_COMPILER="$(lastword $(CC))" \
        -DCMAKE_CXX_COMPILER="$(lastword $(CXX))" \
        -DCMAKE_C_FLAGS="$(strip $(filter-out -I% -D% $(DEPFLAGS),$(CFLAGS)))" \
        -DCMAKE_CXX_FLAGS="$(strip $(filter-out -I% -D% $(DEPFLAGS),$(CXXFLAGS)))" \
        -DSNAPPY_BUILD_TESTS=OFF \
        -DSNAPPY_BUILD_BENCHMARKS=OFF

    # The configuration is redone when the arguments change: SNAPPY_STAMP records
    # them and is rewritten, while the Makefile is read, whenever they differ.
    SNAPPY_STAMP := $(SNAPPY_BUILD)/lzbench-config
    ifneq ($(shell cat $(SNAPPY_STAMP) 2>/dev/null),$(SNAPPY_CMAKE_ARGS))
        $(shell mkdir -p $(SNAPPY_BUILD) && echo '$(SNAPPY_CMAKE_ARGS)' > $(SNAPPY_STAMP))
    endif
endif

# CMake leaves generated files alone when their contents do not change, so touch
# config.h: otherwise it would stay older than its prerequisites, and CMake
# would run on every make. The cache is removed so that every probe is redone.
$(SNAPPY_BUILD)/config.h: $(SNAPPY_STAMP) $(addprefix $(SRC)lz/snappy/,CMakeLists.txt cmake/config.h.in snappy-stubs-public.h.in)
	@echo "Configuring snappy..."
	rm -rf $(SNAPPY_BUILD)/CMakeCache.txt $(SNAPPY_BUILD)/CMakeFiles
	cmake -S $(SRC)lz/snappy -B $(SNAPPY_BUILD) -G "Unix Makefiles" $(SNAPPY_CMAKE_ARGS)
	touch $@
